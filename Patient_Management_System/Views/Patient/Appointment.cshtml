                                                    }

                                                    .formbold-form-label {
                                                        display: block;
                                                        font-weight: 500;
                                                        font-size: 16px;
                                                        color: #07074d;
                                                        margin-bottom: 12px;
                                                    }

                                                    .formbold-form-label-2 {
                                                        font-weight: 600;
                                                        font-size: 20px;
                                                        margin-bottom: 20px;
                                                    }

                                                    .formbold-form-input {
                                                        width: 100%;
                                                        padding: 12px 24px;
                                                        border-radius: 6px;
                                                        border: 1px solid #e0e0e0;
                                                        background: white;
                                                        font-weight: 500;
                                                        font-size: 16px;
                                                        color: #6b7280;
