@model Patient_Management_System.ViewModel.AppointmentVM
@{
    Layout = "~/Views/Shared/_Layout_Patient.cshtml";
}

@using (Html.BeginForm("Appointment", "Patient", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
    }
    if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
    }

    <div class="container">
        <h2>Book an Appointment</h2>
        </div>
       
    <div class="col-sm-6">

        <div class="input-group">
            <span class="input-group-text"><i class="fa fa-hospital-o"></i></span>
            <label>Department</label>
            @Html.DropDownList("Dept_ID", (IEnumerable<SelectListItem>)ViewBag.Dept_ID, "-- Select Department --", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Dept_ID, "", new { @class = "text-danger" })
        </div>


        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fa fa-user-md"></i></span>
                <label>Doctor</label>
                @Html.DropDownList("Doctor_ID", new SelectList(Enumerable.Empty<SelectListItem>()), "-- Select Doctor --", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                <label>Date</label>
                @Html.TextBoxFor(model => model.Apt_Date, new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd"), required = "required" })
                @Html.ValidationMessageFor(model => model.Apt_Date, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fa fa-clock-o"></i></span>
                <label>Time Slot</label>

                @Html.DropDownListFor(model => model.Apt_Time, ViewBag.TimeSlots as List<SelectListItem>, "-- Select Time --", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.Apt_Time, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fa fa-align-left"></i></span>
                <label>Description</label>
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 3, placeholder = "Enter details" })
            </div>
        </div>


        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-phone"></i>
                </span>
               <label>Phone</label>
                @Html.TextBoxFor(model => model.Phone, new { @class = "form-control", required = "required", placeholder = "Enter phone number" })
            </div>
        </div>
        <div class="col-sm-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-stethoscope"></i>
                </span>
                @Html.TextBoxFor(model => model.Diseases, new { @class = "form-control", style = "height:49px;", placeholder = "Diseases" })
            </div>
            @Html.ValidationMessageFor(model => model.Diseases, "", new { @class = "text-danger" })
        </div>


        <div class="col-sm-12 text-center mt-4">
            <button type="submit" class="formbold-btn">Make Appointment</button>
        </div>
    </div>
                                                }
                                                <script src="~/Content/Appointment/js/jquery.min.js"></script>
                                                <script src="~/Content/Appointment/js/popper.min.js"></script>
                                                <script src="~/Content/Appointment/js/bootstrap.bundle.min.js"></script>
                                                <script src="~/Content/Appointment/js/jquery-3.0.0.min.js"></script>
                                                <script src="~/Content/Appointment/js/plugin.js"></script>
                                                <script src="js/jquery.mCustomScrollbar.concat.min.js"></script>
                                                <script src="js/custom.js"></script>
                                                <script src="https:cdnjs.cloudflare.com/ajax/libs/fancybox/2.1.5/jquery.fancybox.min.js"></script>
                                                <script src="https://unpkg.com/gijgo@1.9.13/js/gijgo.min.js" type="text/javascript"></script>


                                                <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                                                <script>
                                                    $(document).ready(function () {
                                                        $("#Dept_ID").change(function () {
                                                            var deptId = $(this).val();
                                                            if (deptId) {
                                                                $.getJSON('/Patient/GetDoctorsByDepartment', { deptId: deptId }, function (data) {
                                                                    var doctorDropdown = $("#Doctor_ID");
                                                                    doctorDropdown.empty();
                                                                    doctorDropdown.append('<option value="">-- Select Doctor --</option>');
                                                                    $.each(data, function (index, item) {
                                                                        doctorDropdown.append('<option value="' + item.Doctor_ID + '">' + item.Dr_FirstName + '</option>');
                                                                    });
                                                                });
                                                            }
                                                        });
                                                    });
                                                </script>
                                                <script>
                                                    $(document).ready(function () {
                                                        $("#Doctor_ID, #Apt_Date").change(function () {
                                                            var doctorId = $("#Doctor_ID").val();
                                                            var date = $("#Apt_Date").val();

                                                            if (doctorId && date) {
                                                                $.getJSON('/Appointment/GetAvailableSlots', { doctorId: doctorId, date: date }, function (data) {
                                                                    var timeSlotDropdown = $("#TimeSlot");
                                                                    timeSlotDropdown.empty();
                                                                    $.each(data, function (index, item) {
                                                                        timeSlotDropdown.append($('<option>', { value: item, text: item }));
                                                                    });
                                                                });
                                                            }
                                                        });
                                                    });
                                                </script>


                                                <script>
                                                    $('#datepicker').datepicker({
                                                        uiLibrary: 'bootstrap'
                                                    });
                                                </script>




                                                <script>
                                                    $('#timepicker').timepicker({
                                                        uiLibrary: 'bootstrap'
                                                    });
                                                </script>

