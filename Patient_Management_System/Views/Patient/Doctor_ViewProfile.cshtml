@model Patient_Management_System.ViewModel.DoctorVM

@{
    Layout = "~/Views/Shared/_Layout_Patient.cshtml";
    ViewBag.Title = "Doctor Profile - LiveDoc Multispecialist Hospital";
    string statusClass = Model.Dr_Status == "Active" || Model.Dr_Status == "Available" ? "bg-success" : "bg-danger";
}
<br>
<br>
<br>
<div class="container mt-5">
    <div class="card profile-card shadow-lg p-4">
        <div class="text-center">
            @if (!string.IsNullOrEmpty(Model.Dr_ImagePath))
            {
                <img src="@Url.Content(Model.Dr_ImagePath)" alt="Doctor Image" class="img-fluid doctor-img mb-3" />
            }
            else
            {
                <img src="~/Images/default-doctor.png" alt="No Image" class="img-fluid doctor-img mb-3" />
            }
            <h3 class="mt-3 text-primary">@Model.Dr_FirstName @Model.Dr_LastName</h3>
            <span class="badge badge-status @statusClass">@Model.Dr_Status</span>
        </div>

        <div class="mt-4">
            <h5 class="text-secondary">🩺 Department</h5>
            <p>@Model.Dept_Name</p>
            <h5 class="text-secondary">🎓 Qualification</h5>
            <p>@Model.Dr_Qualification</p>
        </div>

        <hr />
        <div>
            <h5 class="text-secondary">📞 Contact Information</h5>
            <p><strong>📧 Email:</strong> @Model.Dr_Email</p>
            <p><strong>📱 Phone:</strong> @Model.Dr_Phone</p>
        </div>

        <div class="text-center mt-4">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">🔙 Back</a>
            <a href="@Url.Action("Appointment", "Patient", new { doctorId = Model.Doctor_ID })" class="btn btn-primary">📅 Book Appointment</a>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7fc;
        font-family: 'Poppins', sans-serif;
    }

    .profile-card {
        max-width: 450px;
        margin: auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .doctor-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #007bff;
        padding: 5px;
    }

    .badge-status {
        font-size: 14px;
        padding: 8px 15px;
        border-radius: 20px;
        color: white;
    }

    .bg-success {
        background-color: #28a745;
    }

    .bg-danger {
        background-color: #dc3545;
    }

    .btn {
        font-size: 16px;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-outline-secondary {
        border: 2px solid #6c757d;
        color: #6c757d;
    }

        .btn-primary:hover, .btn-outline-secondary:hover {
            opacity: 0.85;
        }
</style>
</br>