@model List<Patient_Management_System.ViewModel.DoctorVM>

@{
    Layout = "~/Views/Shared/_Layout_Patient.cshtml";
    ViewBag.Title = "Search Doctors";
}

<div class="page-wrapper">
    <h2 class="display-6 text-center">
        <span style="color: #000000; font-weight: bold;">S</span>earch
        <span style="color: #007bff; font-weight: bold;">D</span>octor,
        <span style="color: #007bff; font-weight: bold;">M</span>ake
        <span style="color: #000000; font-weight: bold;">A</span>ppointment
    </h2>

    <div class="container mt-4">
        <div class="d-flex justify-content-center">
            @using (Html.BeginForm("Search_Doctor", "Patient", FormMethod.Get, new { @class = "search-container" }))
            {
                <i class="fas fa-search"></i>
                <input type="text" name="searchTerm" id="searchTerm" placeholder="Search by Doctor or Department" class="form-control">
                <button type="submit">Search</button>
            }
        </div>

        <div class="mt-4">
            @if (Model != null && Model.Count > 0)
            {
                <div class="row">
                    @foreach (var doctor in Model)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card doctor-card p-4 text-center">
                                <!-- Doctor Image -->
                                <div class="doctor-profile">
                                    @if (!string.IsNullOrEmpty(doctor.Dr_ImagePath))
                                    {
                                        <img src="@Url.Content(doctor.Dr_ImagePath)" alt="Doctor Image" class="img-fluid doctor-img mb-3" />
                                    }
                                    else
                                    {
                                        <img src="~/Images/default-doctor.png" alt="No Image" class="img-fluid doctor-img mb-3" />
                                    }
                                </div>

                                <!-- Doctor Details -->
                                <h4 class="text-dark">Dr. @doctor.Dr_FirstName @doctor.Dr_LastName</h4>
                                <p class="text-muted font-italic">@doctor.Dept_Name</p>

                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"><strong>Qualification:</strong> @doctor.Dr_Qualification</li>
                                    <li class="list-group-item"><strong>Fees:</strong> ₹ @doctor.Fees</li>

                                    <li class="list-group-item">
                                        <strong><i class="fa fa-calendar-alt text-primary"></i> Dates:</strong>
                                        @if (doctor.Available_Date.Any())
                                        {
                                            <div class="custom-dropdown mt-2">
                                                <select class="form-select date-dropdown" data-doctor-id="@doctor.Doctor_ID">
                                                    @foreach (var date in doctor.Available_Date)
                                                    {
                                                        var startTime = doctor.DateTimeSlots[date].Item1.ToString(@"hh\:mm");
                                                        var endTime = doctor.DateTimeSlots[date].Item2.ToString(@"hh\:mm");
                                                        var status = doctor.DateTimeSlots[date].Item3;

                                                        <option value="@date.ToString("yyyy-MM-dd")"
                                                                data-start-time="@startTime"
                                                                data-end-time="@endTime"
                                                                data-status="@status">
                                                            @date.ToString("dd/MM/yyyy")
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger">N/A</span>
                                        }
                                    </li>

                                    <li class="list-group-item">
                                        <strong><i class="fa fa-clock text-warning"></i> Time:</strong>
                                        <span class="text-dark fw-bold start-time">
                                            @(doctor.Start_Time.HasValue ? doctor.Start_Time.Value.ToString(@"hh\:mm") : "N/A")
                                        </span>
                                        -
                                        <span class="text-dark fw-bold end-time">
                                            @(doctor.End_Time.HasValue ? doctor.End_Time.Value.ToString(@"hh\:mm") : "N/A")
                                        </span>
                                    </li>

                                    <li class="list-group-item">
                                        <strong class="me-2">Status:</strong>
                                        <span class="badge doctor-status @(doctor.Status == "Active" ? "bg-success" : "bg-danger") p-2 rounded-pill shadow-sm">
                                            @doctor.Status
                                        </span>
                                    </li>

                                </ul>

                                <div class="mt-3">
                                    <a href="@Url.Action("Doctor_ViewProfile", "Patient", new { id = doctor.Doctor_ID })" class="btn btn-primary btn-sm">
                                        <i class="fa fa-user-md"></i> View Profile
                                    </a>
                                    <a href="@Url.Action("Appointment", "Patient")" class="btn btn-info btn-sm">
                                        <i class="fa fa-calendar"></i> Book Appointment
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center mt-4">
                    <strong>No doctors found.</strong>
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('.date-dropdown').on('change', function () {
            var selectedOption = $(this).find('option:selected');
            var startTime = selectedOption.data('start-time');
            var endTime = selectedOption.data('end-time');
            var status = selectedOption.data('status');

            var doctorCard = $(this).closest('.doctor-card');
            doctorCard.find('.start-time').text(startTime);
            doctorCard.find('.end-time').text(endTime);

            var statusBadge = doctorCard.find('.doctor-status');
            statusBadge.text(status);
            statusBadge.removeClass("bg-success bg-danger").addClass(status === "Active" ? "bg-success" : "bg-danger");
        });

        $('.date-dropdown').each(function () {
            $(this).trigger('change');
        });
    });

</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    body {
        background: #f9f9f9;
        font-family: 'Poppins', sans-serif;
    }

    .search-container {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 50px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        max-width: 600px;
        width: 100%;
        margin-top: 40px;
        padding: 8px;
    }

        .search-container i {
            padding: 15px;
            font-size: 18px;
            color: #555;
        }

        .search-container input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            padding: 10px;
            font-size: 16px;
        }

        .search-container button {
            background: linear-gradient(120deg, #ff5722, #ff9800);
            border: none;
            color: white;
            padding: 12px 25px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 50px;
        }

    .doctor-card {
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        background: #fff;
        transition: transform 0.3s ease-in-out;
    }

        .doctor-card:hover {
            transform: translateY(-5px);
        }

    .doctor-profile img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #007bff;
        padding: 5px;
    }

    .custom-dropdown .form-select {
        background-color: #f8f9fa;
        border: 2px solid #007bff;
        border-radius: 0.25rem;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        color: #495057;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .custom-dropdown .form-select {
        margin-left: 90px;
        width: 150px;
    }

        .custom-dropdown .form-select:focus {
            border-color: #0056b3;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
            outline: none;
        }

    .list-group-item {
        font-size: 15px;
        padding: 10px 15px;
        background: #f9f9f9;
        border: none;
    }

    .btn-sm {
        padding: 7px 12px;
        font-size: 14px;
        font-weight: bold;
    }

    .badge-success {
        background-color: #28a745;
        padding: 5px 10px;
        font-size: 13px;
        border-radius: 5px;
    }

    .badge-danger {
        background-color: #dc3545;
        padding: 5px 10px;
        font-size: 13px;
        border-radius: 5px;
    }
</style>

