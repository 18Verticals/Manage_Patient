@model Patient_Management_System.ViewModel.AppointmentVM
@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@using (Html.BeginForm("Edit_Appointment", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })



    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
   alert("@ViewBag.Message");
        </script>
    }


    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Edit Appointment</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">
                @Html.HiddenFor(m => m.Appointment_ID)


                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor Name</label>
                        <input type="text" class="form-control" value="@ViewBag.SelectedDoctorName" readonly disabled />
                        @Html.HiddenFor(model => model.Doctor_ID)
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Specialities</label>
                        <input type="text" class="form-control" value="@ViewBag.SelectedDepartmentName" readonly disabled />
                        @Html.HiddenFor(model => model.Dept_ID)
                    </div>
                </div>



                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.ValidationMessageFor(model => model.Apt_Date, "", new { @class = "text-danger" })
                        @Html.TextBoxFor(model => model.Apt_Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })

                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Time Slot</label>
                        @Html.EditorFor(model => model.Apt_Time, new { htmlAttributes = new { @class = "form-control", type = "time", min = "09:30", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Apt_Time, "", new { @class = "text-danger" })
                    </div>
                </div>



                <!-- Diseases -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Diseases</label>
                        @Html.EditorFor(model => model.Diseases, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Diseases, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Phone -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Contact</label>
                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Description -->
                <div class="col-sm-12">
                    <div class="form-group">
                        <label>Description</label>
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 1, required = "required" })
                    </div>
                </div>




            </div>
        </div>
    </div>

    <div class="m-t-20 text-center">
        <button class="btn btn-primary submit-btn" style="margin-left:-10px;">Update Appointment</button>
    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#Dept_ID").change(function () {
            var deptId = $(this).val();
            if (deptId) {
                $.ajax({
                    url: '@Url.Action("GetDoctorsBySpecialty", "Admin")',
                    type: "GET",
                    data: { deptId: deptId },
                    success: function (data) {
                        var doctorDropdown = $("#Doctor_ID");
                        doctorDropdown.empty().append('<option value="">-- Select Doctor --</option>');
                        $.each(data, function (index, item) {
                            doctorDropdown.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                        });
                    },
                    error: function () {
                        alert("Error retrieving doctors.");
                    }
                });
            } else {
                $("#Doctor_ID").empty().append('<option value="">-- Select Doctor --</option>');
            }
        });
    });
</script>