@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Doctor</h4>
    </div>
    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="Add_Doctor" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i>Add Doctor</a>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-border table-striped custom-table datatable mb-0">
                <thead>
                    <tr>
                        <th class="text-right">ACTION</th>

                        <th>IMAGE</th>
                        <th>FIRSTNAME</th>
                        <th>LASTNAME</th>
                        <th>SPECIALITIES</th>
                        <th>EMAIL</th>
                        <th>PASSWORD</th>
                        <th>DOB</th>
                        <th>GENDER</th>
                        <th>PHONE</th>
                        <th>DEGREE</th>
                        <th>ADDRESS</th>
                        <th>CITY</th>
                        <th>STATE</th>
                        <th>PINCODE</th>
                        <th>FEES</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctorVM in Model)
                    {

                        <tr>
                            <td class="text-right">
                                <a class="dropdown-item" href="@Url.Action("Edit_Doctor", new { doctorId = doctorVM.Doctor_ID })">
                                    <i class="fa fa-pencil m-r-5"></i>
                                </a>
                                <script type="text/javascript">
                                    function confirmDelete(url) {
                                        if (confirm("Are you sure you want to delete this doctor?")) {
                                            window.location.href = url;
                                        }
                                    }
                                </script>

                                <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Doctor", "Admin", new { doctorId = doctorVM.Doctor_ID })')">
                                    <i class="fa fa-trash-o m-r-5"></i>
                                </a>
                            </td>


                            <td>
                                @if (!string.IsNullOrEmpty(doctorVM.Dr_ImagePath))
                                {
                                    <img src="@Url.Content(doctorVM.Dr_ImagePath)" alt="Doctor Image" width="50" height="50" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
                            <td>Dr.@doctorVM.Dr_FirstName</td>
                            <td>@doctorVM.Dr_LastName</td>
                            <td>@doctorVM.Dept_Name</td>
                            <td>@doctorVM.Dr_Email</td>
                            <td>@doctorVM.Dr_Password</td>
                            <td>@doctorVM.Dr_DOB.ToString("dd/MM/yyyy")</td>
                            <td>@doctorVM.Dr_Gender</td>
                            <td>@doctorVM.Dr_Phone</td>
                            <td>@doctorVM.Dr_Qualification</td>
                            <td>@doctorVM.Dr_Address</td>
                            <td>@doctorVM.Dr_City</td>
                            <td>@doctorVM.Dr_State</td>
                            <td>@doctorVM.Dr_Pincode</td>
                            <td>@doctorVM.Fees</td>

                            <td>@doctorVM.Dr_Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="sidebar-overlay" data-reff=""></div>
<script src="assets/js/jquery-3.2.1.min.js"></script>
<script src="assets/js/popper.min.js"></script>
<script src="assets/js/bootstrap.min.js"></script>
<script src="assets/js/jquery.slimscroll.js"></script>
<script src="assets/js/select2.min.js"></script>
<script src="assets/js/jquery.dataTables.min.js"></script>
<script src="assets/js/dataTables.bootstrap4.min.js"></script>
<script src="assets/js/moment.min.js"></script>
<script src="assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="assets/js/app.js"></script>


