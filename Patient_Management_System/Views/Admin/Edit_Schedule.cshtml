@model Patient_Management_System.ViewModel.ScheduleVM

@{
    ViewBag.Title = "Edit Schedule";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@using (Html.BeginForm("Edit_Schedule", "Admin", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()

    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Edit Schedule</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">

                @Html.HiddenFor(model => model.Schedule_ID)

                <!-- Doctor -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor Name</label>
                        @Html.DropDownListFor(model => model.Doctor_ID, ViewBag.Doctor_ID as IEnumerable<SelectListItem>, "-- Select Doctor --", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Specialities</label>
                        @Html.DropDownListFor(model => model.Dept_ID, ViewBag.Dept_ID as IEnumerable<SelectListItem>, "-- Select Specialities --", new { @class = "form-control", id = "Dept_ID", disabled = "disabled" })
                        <input type="hidden" id="Hidden_Dept_ID" name="Dept_ID" />
                    </div>
                </div>

                <!-- Date -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.TextBoxFor(model => model.Available_Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Start Time</label>
                        @Html.EditorFor(model => model.Start_Time, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>End Time</label>
                        @Html.EditorFor(model => model.End_Time, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                    </div>
                </div>

                <!-- Status -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Status:</label>
                        @Html.DropDownListFor(model => model.Status, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Active", Value = "Active" },
                            new SelectListItem { Text = "Inactive", Value = "Inactive" }
                        }, "Select Status", new { @class = "form-control" })
                    </div>

                    <div class="m-t-20 text-center">
                        <button class="btn btn-primary submit-btn">Update Schedule</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#Doctor_ID").change(function () {
                var doctorId = $(this).val();
                if (doctorId) {
                    $.ajax({
                        url: '@Url.Action("GetDepartmentByDoctor", "Admin")',
                        type: "GET",
                        data: { doctorId: doctorId },
                        success: function (data) {
                            if (data) {
                                $("#Dept_ID").val(data.Dept_ID).prop("disabled", true);
                                $("#Hidden_Dept_ID").val(data.Dept_ID);
                            }
                        },
                        error: function () {
                            alert("Error retrieving department data.");
                        }
                    });
                }
            });

            // Auto-fill department on page load
            var selectedDoctor = $("#Doctor_ID").val();
            if (selectedDoctor) {
                $("#Doctor_ID").trigger("change");
            }
        });
    </script>
}
