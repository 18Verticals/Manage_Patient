@model Patient_Management_System.ViewModel.ScheduleVM

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}
@using (Html.BeginForm("Edit_Schedule", "Admin", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()

    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
         alert("@ViewBag.Message");
        </script>
    }

    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }


    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Edit Schedule</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">

                @Html.HiddenFor(model => model.Schedule_ID)

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor Name</label>
                        @Html.DropDownListFor(model => model.Doctor_Name, (IEnumerable<SelectListItem>)ViewBag.Doctor_ID, "---Select---",
                                 new { @class = "form-control", required = "required", @id = "Doctor_ID" })
                        @Html.ValidationMessageFor(model => model.Doctor_Name, "", new { @class = "text-danger" })
                        <input type="hidden" id="Hidden_Doctor_ID" name="Doctor_Name" value="@Model.Doctor_Name" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Specialities</label>
                        @Html.DropDownListFor(model => model.Department_Name, (IEnumerable<SelectListItem>)ViewBag.Dept_ID, "---Select---",
                                 new { @class = "form-control", @id = "Dept_ID", required = "required" })
                        @Html.ValidationMessageFor(model => model.Department_Name, "", new { @class = "text-danger" })
                        <input type="hidden" id="Hidden_Dept_ID" name="Department_Name" value="@Model.Department_Name" />
                    </div>
                </div>


                <!-- Date -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.TextBoxFor(model => model.Available_Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.Available_Date, "", new { @class = "text-danger" })


                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Start Time</label>
                        @Html.EditorFor(model => model.Start_Time, new { htmlAttributes = new { @class = "form-control", type = "time", min = "09:30", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Start_Time, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-group">
                        <label>End Time</label>
                        @Html.EditorFor(model => model.End_Time, new { htmlAttributes = new { @class = "form-control", type = "time", max = "18:30", required = "required" } })
                        @Html.ValidationMessageFor(model => model.End_Time, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Status -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Status:</label>
                        @Html.DropDownListFor(model => model.Status, new List<SelectListItem>
                                                {
                            new SelectListItem { Text = "Active", Value = "Active" },
                            new SelectListItem { Text = "Inactive", Value = "Inactive" }
                        }, "Select Status", new { @class = "form-control", @id = "Dr_Status", required = "required" })
                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                    </div>

                    <!-- Submit Button -->
                    <div class="m-t-20 text-center">
                        <button class="btn btn-primary submit-btn" style="margin-left:-350px;">Update Schedule</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
   $(document).ready(function () {
    $("#Doctor_ID").change(function () {
        var doctorId = $(this).val();
        $("#Hidden_Doctor_ID").val(doctorId);

        if (doctorId) {
            $.ajax({
                url: '@Url.Action("GetDepartmentByDoctor", "Admin")',
                type: "GET",
                data: { doctorId: doctorId },
                success: function (data) {
                    if (data) {
                        $("#Dept_ID").val(data.Dept_ID);
                        $("#Hidden_Dept_ID").val(data.Dept_ID);
                    }
                },
                error: function () {
                    alert("Error retrieving department data.");
                }
            });
        }
    });

    $("#Dept_ID").change(function () {
        $("#Hidden_Dept_ID").val($(this).val());
    });
});

    </script>
}