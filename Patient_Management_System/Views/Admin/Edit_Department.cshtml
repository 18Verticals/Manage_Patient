
@model Patient_Management_System.ViewModel.DepartmentVM

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}
@using (Html.BeginForm("Edit_Department", "Admin", FormMethod.Post))

{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()

    if (ViewBag.Message != null)
    {
        <div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
            <strong>@ViewBag.Message</strong>
            <strong>@ViewBag.Error</strong>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Edit Specialities</h4>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <form>
                <div class="row">

                    @Html.HiddenFor(model => model.Dept_ID)


                    <!-- Department  -->
                    <div class="col-sm-9">
                        <div class="form-group">

                            @Html.EditorFor(model => model.Dept_Name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                            @Html.ValidationMessageFor(model => model.Dept_Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
        </div>
    </div>


    <!-- Submit Button -->
    <div class="m-t-20 text-center">
        <button class="btn btn-primary submit-btn" style="margin-left:130px; ">Update Specialities</button>
    </div>
}
