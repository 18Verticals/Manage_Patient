@model IEnumerable<Patient_Management_System.Models.ScheduleTbl>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Schedule</h4>
    </div>

    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="@Url.Action("Add_Schedule", "Admin")" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i> Add Schedule</a>
    </div>
</div>

<table class="table">
    <tr>
        <th></th>
      
        <th>Doctor</th>
        <th>Specialities</th>
        <th>Availabe Date</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Status</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td class="text-right">
                <a class="dropdown-item" href="@Url.Action("Edit_Schedule", new { scheduleId = item.Schedule_ID })">
                    <i class="fa fa-pencil m-r-5"></i>
                </a>

                <!-- Add JavaScript confirmation for delete -->
                <script type="text/javascript">
                    function confirmDelete(url) {
                        if (confirm("Are you sure you want to delete this Schedule?")) {
                            window.location.href = url;
                        }
                    }
                </script>
                <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Schedule", new { scheduleId = item.Schedule_ID })')">
                    <i class="fa fa-trash-o m-r-5"></i>
                </a>
            </td>
  
            <td>
                Dr. @(item.DoctorTbl.Dr_FirstName ?? "N/A") @(item.DoctorTbl.Dr_LastName ?? "N/A")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentTbl.Dept_Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Available_Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Start_Time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.End_Time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
        </tr>
    }

</table>