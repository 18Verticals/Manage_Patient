@model Patient_Management_System.ViewModel.PrescriptionVM
@{
    ViewBag.Title = "Edit_Prescription";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@using (Html.BeginForm("Edit_Prescription", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()


    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
         alert("@ViewBag.Message");
        </script>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Edit Prescription</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">
                @Html.HiddenFor(m => m.Presc_ID)

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor Name</label>
                        <input type="text" class="form-control" value="@Model.Doctor_Name" readonly />
                        <input type="hidden" name="Doctor_ID" value="@Model.Doctor_ID" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Patient Name</label>
                        <input type="text" class="form-control" value="@Model.Patient_Name" readonly />
                        <input type="hidden" name="Patient_ID" value="@Model.Patient_ID" />
                    </div>
                </div>


                <!-- Date -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.TextBoxFor(model => model.DateIssued, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd"), required = "required" })
                        @Html.ValidationMessageFor(model => model.DateIssued, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Medication</label>
                        @Html.EditorFor(model => model.Medication, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Medication, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Dosage</label>
                        @Html.EditorFor(model => model.Dosage, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Dosage, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Instruction</label>
                        @Html.TextAreaFor(model => model.Instructions, new { @class = "form-control", required = "required", rows = "1" })
                        @Html.ValidationMessageFor(model => model.Instructions, "", new { @class = "text-danger" })
                    </div>
                </div>




            </div>
            <!-- Submit Button -->
            <div class="m-t-20 text-center">
                <button class="btn btn-primary submit-btn" style="margin-left:-10px;">Update Prescription</button>
            </div>

        </div>

    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
$(document).ready(function () {
    $("#Doctor_ID").change(function () {
        var doctorId = $(this).val();
        if (doctorId) {
            $.ajax({
                url: '@Url.Action("GetPatientsByDoctor", "Admin")',
                type: "GET",
                data: { Doctor_ID: doctorId },
                success: function (data) {
                    var patientDropdown = $("#Patient_ID");
                    patientDropdown.empty();
                    patientDropdown.append('<option value="">-- Select Patient --</option>');
                    $.each(data, function (index, patient) {
                        patientDropdown.append('<option value="' + patient.Value + '">' + patient.Text + '</option>');
                    });
                }
            });
        }
    });
});

    </script>
}
