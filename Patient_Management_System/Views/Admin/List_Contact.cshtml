

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-sm-5 col-5">
        <h4 class="page-title">Contact</h4>
    </div>
    <div class="col-sm-7 col-7 text-right m-b-30">
        <a href="Add_Contact " class="btn btn-primary btn-rounded"><i class="fa fa-plus"></i> Add contact</a>

    </div>
</div>


<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("List_Contact", "Admin")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Contact..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div style="overflow-x:auto;">
    <table class="table table-striped">
        <thead class="bg-danger text-white">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-border table-striped custom-table datatable mb-0">
                            <thead>
                                <tr>
                                    <th> </th>
                                    <th>Name</th>
                                    <th> Email </th>
                                    <th>Message</th>
                                    <th>Phone</th>

                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <a class="dropdown-item" href="@Url.Action("Edit_Contact", new { id = item.Feedback_Id })">
                                                <i class="fa fa-pencil m-r-5"></i>
                                            </a>

                                            <script type="text/javascript">
                                                function confirmDelete(url) {
                                                    if (confirm("Are you sure you want to delete this Contact?")) {
                                                        window.location.href = url;
                                                    }
                                                }
                                            </script>

                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Contact", new { id = item.Feedback_Id })')">
                                                <i class="fa fa-trash-o m-r-5"></i>
                                            </a>
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@item.Email </td>
                                        <td>@item.Message</td>
                                        <td> @item.Phone</td>
                                    </tr>
                                }
                        </table>
                    </div>
                </div>
            </div>

            <nav aria-label="Contact Pagination">
                <ul class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Contact", new { page = Model.PageNumber - 1 })">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="#">@i</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("List_Contact", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Contact", new { page = Model.PageNumber + 1 })">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                </ul>
            </nav>

            </table>
        </div>
    </div>
</div>



