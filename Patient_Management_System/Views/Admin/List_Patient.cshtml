@{
    ViewBag.Title = "List_Patient";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}



<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Patients</h4>
    </div>
    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="Add_Patient" class="btn btn-primary btn-rounded float-right">
            <i class="fa fa-plus"></i> Add Patient
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("List_Patient", "Admin")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Patient..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div style="overflow-x:auto;">
    <table class="table table-striped">
        <thead class="bg-danger text-white">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-border table-striped custom-table datatable mb-0">
                            <thead>
                                <tr>
                                    <th class="text-right"></th>
                                    <th>IMAGE</th>
                                    <th>FIRST NAME</th>
                                    <th>MIDDLE NAME</th>
                                    <th>LAST NAME</th>
                                    <th>GENDER</th>
                                    <th>DOB</th>
                                    <th>EMAIL</th>
                                    <th>PASSWORD</th>
                                    <th>PHONE</th>
                                    <th>BLOOD GRP</th>
                                    <th>ADDRESS</th>
                                    <th>CITY</th>
                                    <th>STATE</th>
                                    <th>PINCODE</th>
                                    <th>MESSAGE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var patientTbl in Model)
                                {
                                    <tr>
                                        <td class="text-right">
                                            <a class="dropdown-item" href="@Url.Action("Edit_Patient", new { patientId = patientTbl.Patient_Id })">
                                                <i class="fa fa-pencil m-r-5"></i>
                                            </a>
                                            <!-- Add JavaScript confirmation for delete -->

                                            <script type="text/javascript">
                                                function confirmDelete(url) {
                                                    if (confirm("Are you sure you want to delete this Patient?")) {
                                                        window.location.href = url;
                                                    }
                                                }
                                            </script>

                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Patient", new { patientId = patientTbl.Patient_Id })')">

                                                <i class="fa fa-trash-o m-r-5"></i>
                                            </a>
                                        </td>
                                        <td>

                                            @if (!string.IsNullOrEmpty(patientTbl.P_Image))
                                            {
                                                <img src="@Url.Content(patientTbl.P_Image)" alt="Patient Image" width="50" height="50" />

                                            }
                                            else
                                            {
                                                <span>No Image</span>
                                            }
                                        </td>

                                        <td>@patientTbl.P_FirstName</td>
                                        <td>@patientTbl.P_MiddleName</td>
                                        <td>@patientTbl.P_LastName</td>
                                        <td>@patientTbl.P_Gender</td>
                                        <td>@patientTbl.P_DOB.ToString("dd-MM-yyyy")</td>
                                        <td>@patientTbl.P_Email</td>
                                        <td>@patientTbl.P_Password</td>
                                        <td>@patientTbl.P_Phone</td>
                                        <td>@patientTbl.P_BloodGrp</td>
                                        <td>@patientTbl.P_Address</td>
                                        <td>@patientTbl.P_City</td>
                                        <td>@patientTbl.P_State</td>
                                        <td>@patientTbl.P_Pincode</td>
                                        <td>@patientTbl.P_Message</td>


                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>



                    <nav aria-label="Patient Pagination">
                        <ul class="pagination">
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("List_Patient", new { page = Model.PageNumber - 1 })">Previous</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <a class="page-link" href="#">Previous</a>
                                </li>
                            }

                            @for (int i = 1; i <= Model.PageCount; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("List_Patient", new { page = i })">@i</a>
                                </li>
                            }

                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("List_Patient", new { page = Model.PageNumber + 1 })">Next</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <a class="page-link" href="#">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>

                    <script>
                        function confirmDelete(url) {
                            if (confirm("Are you sure you want to delete this Patient?")) {
                                window.location.href = url;
                            }
                        }
                    </script>

                    <script src="assets/js/jquery-3.2.1.min.js"></script>
                    <script src="assets/js/popper.min.js"></script>
                    <script src="assets/js/bootstrap.min.js"></script>
                    <script src="assets/js/jquery.slimscroll.js"></script>
                    <script src="assets/js/select2.min.js"></script>
                    <script src="assets/js/jquery.dataTables.min.js"></script>
                    <script src="assets/js/dataTables.bootstrap4.min.js"></script>
                    <script src="assets/js/moment.min.js"></script>
                    <script src="assets/js/bootstrap-datetimepicker.min.js"></script>
                    <script src="assets/js/app.js"></script>
                </div>
            </div>
</div>

<nav aria-label="Patient Pagination">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("List_Patient", new { page = Model.PageNumber - 1 })">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            if (i == Model.PageNumber)
            {
                <li class="page-item active">
                    <a class="page-link" href="#">@i</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("List_Patient", new { page = i })">@i</a>
                </li>
            }
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("List_Patient", new { page = Model.PageNumber + 1 })">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#">Next</a>
            </li>
        }
    </ul>
</nav>


<div class="sidebar-overlay" data-reff=""></div>
<script src="assets/js/jquery-3.2.1.min.js"></script>
<script src="assets/js/popper.min.js"></script>
<script src="assets/js/bootstrap.min.js"></script>
<script src="assets/js/jquery.slimscroll.js"></script>
<script src="assets/js/select2.min.js"></script>
<script src="assets/js/jquery.dataTables.min.js"></script>
<script src="assets/js/dataTables.bootstrap4.min.js"></script>
<script src="assets/js/moment.min.js"></script>
<script src="assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="assets/js/app.js"></script>


