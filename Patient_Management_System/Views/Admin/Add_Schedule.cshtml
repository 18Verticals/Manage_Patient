@model Patient_Management_System.ViewModel.ScheduleVM

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@using (Html.BeginForm("Add_Schedule", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }

    if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">
            <strong>@ViewBag.Error</strong>
        </div>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Add Schedule</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">

                        <label>Doctor</label>
                        @Html.DropDownList("Doctor_ID", (IEnumerable<SelectListItem>)ViewBag.Doctor_ID, "-- Select Doctor --", new { @class = "form-control", required = "required", @id = "Doctor_ID" })
                        @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
                    </div>
                </div> 
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Specialities</label>
                        @Html.DropDownList("Dept_ID", (IEnumerable<SelectListItem>)ViewBag.Dept_ID, "-- Select Specialities --", new { @class = "form-control", @id = "Dept_ID", @disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.Dept_ID, "", new { @class = "text-danger" })
                        <input type="hidden" id="Hidden_Dept_ID" name="Dept_ID" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Available Date</label>
                        @Html.TextBoxFor(model => model.Available_Date, new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd"), required = "required" })
                        @Html.ValidationMessageFor(model => model.Available_Date, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Start Time</label>
                        @Html.TextBoxFor(model => model.Start_Time, new { @class = "form-control", type = "time", min = "09:30", required = "required" })
                        @Html.ValidationMessageFor(model => model.Start_Time, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>End Time</label>
                        @Html.TextBoxFor(model => model.End_Time, new { @class = "form-control", type = "time", max = "18:30", required = "required" })
                        @Html.ValidationMessageFor(model => model.End_Time, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Status</label>
                        @Html.DropDownListFor(model => model.Status, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Active", Value = "Active" },
                            new SelectListItem { Text = "Inactive", Value = "Inactive" }
                        }, "Select Status", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary submit-btn" style="margin-left:280px;">Add Schedule</button>
                </div>
            </div>
        </div>
    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#Doctor_ID").change(function () {
            var doctorId = $(this).val();
            if (doctorId) {
                $.ajax({
                    url: '@Url.Action("GetDepartmentByDoctor", "Admin")',
                    type: "GET",
                    data: { doctorId: doctorId },
                    success: function (data) {
                        if (data) {
                            $("#Dept_ID").val(data.Dept_ID).prop("disabled", true); // Keep dropdown readonly
                            $("#Hidden_Dept_ID").val(data.Dept_ID); // Store value for submission
                        }
                    },
                    error: function () {
                        alert("Error retrieving department data.");
                    }
                });
            }
        });
    });
</script>

