@{
    ViewBag.Title = "List_Prescription";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Prescription</h4>
    </div>

    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="Add_Prescription" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i>Add Prescription</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("List_Prescription", "Admin")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Prescription..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div style="overflow-x:auto;">
    <table class="table table-striped">
        <thead class="bg-danger text-white">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-border table-striped custom-table datatable mb-0">
                            <thead>
                                <tr>
                                    <th class="text-right"> </th>

                                    <th>Dr Name</th>
                                    <th>Patient Name</th>
                                    <th>DateIssued</th>
                                    <th>Medication</th>
                                    <th>Dosage</th>
                                    <th>Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prescVM in Model)
                                {
                                    <tr>
                                        <td class="text-right">
                                            <a class="dropdown-item" href="@Url.Action("Edit_Prescription","Admin", new { PrescId =prescVM.Presc_ID })"><i class="fa fa-pencil m-r-5"></i></a>

                                            <script type="text/javascript">
                                                function confirmDelete(url) {
                                                    if (confirm("Are you sure you want to delete this Prescription?")) {
                                                        window.location.href = url;
                                                    }
                                                }
                                            </script>
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Prescription","Admin", new { PrescId =prescVM.Presc_ID })')"><i class="fa fa-trash-o m-r-5"></i></a>
                                        </td>

                                        <td>@prescVM.Dr_FirstName @prescVM.Dr_LastName</td>
                                        <td>@prescVM.P_FirstName  @prescVM.P_MiddleName</td>
                                        <td>@prescVM.DateIssued.ToString("dd-MM-yyyy")</td>
                                        <td>@prescVM.Medication</td>
                                        <td>@prescVM.Dosage</td>
                                        <td>@prescVM.Instructions</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <nav aria-label="Precription Pagination">
                <ul class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Precription", new { page = Model.PageNumber - 1 })">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="#">@i</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("List_Precription", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Precription", new { page = Model.PageNumber + 1 })">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                </ul>
            </nav>