@{
    ViewBag.Title = "List_Payment";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Payment</h4>
    </div>

    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="@Url.Action("Add_Payment", "Admin")" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i> Add Payment</a>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-border table-striped custom-table datatable mb-0">
                <thead>

                    <tr>
                        <th></th>
                       
                        <th>PATIENT NAME </th>
                        <th>AMOUNT</th>
                        <th>PAYMENT METHOD</th>
                        <th>PAYMENT DATE</th>
                        <th>STATUS</th>
                        <th>REMARKS</th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                     <a class="dropdown-item" href="@Url.Action("Edit_Payment", new { paymentId = item.Payment_ID })">
                                            <i class="fa fa-pencil m-r-5"></i>
                                        </a>


                                        <!-- Add JavaScript confirmation for delete -->
                                        <script type="text/javascript">
                                            function confirmDelete(url) {
                                                if (confirm("Are you sure you want to delete this Payment History?")) {
                                                    window.location.href = url;
                                                }
                                            }
                                        </script>

                                        <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Payment", new { paymentId = item.Payment_ID })')">
                                            <i class="fa fa-trash-o m-r-5"></i>
                                        </a>                                                               
                            </td>
                            
                            <td>@item.P_FirstName </td>
                            <td>@item.Amount</td>
                            <td> @item.PaymentMethod</td>
                            <td> @item.PaymentDate</td>
                            <td> @item.Status</td>
                            <td> @item.Remarks</td>
                        </tr>
                    }

            </table>
        </div>
    </div>
</div>

