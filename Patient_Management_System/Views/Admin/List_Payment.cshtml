@{
    ViewBag.Title = "List_Payment";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}



@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}


<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Payment</h4>
    </div>

    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="@Url.Action("Add_Payment", "Admin")" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i> Add Payment</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("List_Payment", "Admin")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Payment..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div style="overflow-x:auto;">
    <table class="table table-striped">
        <thead class="bg-danger text-white">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-border table-striped custom-table datatable mb-0">
                            <thead>
                                <tr>
                                    <th></th>

                                    <th>PATIENT NAME </th>
                                    <th>AMOUNT</th>
                                    <th>CARD NUMBER</th>                                    
                                    <th>PAYMENT DATE</th>                                   
                                    <th>REMARKS</th>

                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            <a class="dropdown-item" href="@Url.Action("Edit_Payment", new { paymentId = item.Payment_ID })">
                                                <i class="fa fa-pencil m-r-5"></i>
                                            </a>


                                            <!-- Add JavaScript confirmation for delete -->
                                            <script type="text/javascript">
                                                function confirmDelete(url) {
                                                    if (confirm("Are you sure you want to delete this Payment History?")) {
                                                        window.location.href = url;
                                                    }
                                                }
                                            </script>

                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Payment", new { paymentId = item.Payment_ID })')">
                                                <i class="fa fa-trash-o m-r-5"></i>
                                            </a>
                                        </td>

                                        <td>@item.P_FirstName@item.P_LastName </td>
                                        <td>@item.Amount</td>
                                        <td> @item.CredirCardNumber</td>
                                        <td> @item.PaymentDate</td>
                                       
                                        <td> @item.Remarks</td>
                                    </tr>
                                }

                        </table>
                    </div>
                </div>
            </div>

            <nav aria-label="Payment Pagination">
                <ul class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Payment", new { page = Model.PageNumber - 1 })">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="#">@i</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("List_Payment", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Payment", new { page = Model.PageNumber + 1 })">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                </ul>
            </nav>
