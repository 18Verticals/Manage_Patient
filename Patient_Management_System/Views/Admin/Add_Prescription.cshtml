@model Patient_Management_System.ViewModel.PrescriptionVM

@{
    ViewBag.Title = "Add Prescription";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@using (Html.BeginForm("Add_Prescription", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
     alert("@ViewBag.Message");
        </script>
    }


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    $(document).ready(function () {
        $("#Doctor_ID").change(function () {
            var doctorId = $(this).val();
            if (doctorId) {
                $.ajax({
                    url: '@Url.Action("GetPatientsByDoctor", "Admin")',
                    type: "GET",
                    data: { Doctor_ID: doctorId },
                    success: function (data) {
                        var patientDropdown = $("#Patient_ID");
                        patientDropdown.empty();
                        patientDropdown.append('<option value="">-- Select Patient --</option>');
                        $.each(data, function (index, patient) {
                            patientDropdown.append('<option value="' + patient.Value + '">' + patient.Text + '</option>');
                        });
                    }
                });
            }
        });
    });
    </script>


    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title">Add Prescription</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">

                <!-- Doctor Dropdown -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor</label>
                        @Html.DropDownList("Doctor_ID", (IEnumerable<SelectListItem>)ViewBag.Doctor_ID, "-- Select Doctor --", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Patient Dropdown -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Patient</label>
                        @Html.DropDownList("Patient_ID", (IEnumerable<SelectListItem>)ViewBag.Patient_ID, "-- Select Patient --", new { @class = "form-control", required = "required" })

                        @*@Html.DropDownList("Patient_ID", (IEnumerable<SelectListItem>)ViewBag.Dept_ID, "-- Select Specialities --", new { @class = "form-control", required = "required" })*@
                        @Html.ValidationMessageFor(model => model.Patient_ID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Appointment Date -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.EditorFor(model => model.DateIssued, new { htmlAttributes = new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd"), required = "required" } })
                    </div>
                </div>

                <!-- Description -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Medication </label>
                        @Html.TextAreaFor(model => model.Medication, new { @class = "form-control", rows = 1, required = "required" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Dosage</label>
                        @Html.TextBoxFor(model => model.Dosage, new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <!-- Diseases -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Instructions</label>
                        @Html.TextBoxFor(model => model.Instructions, new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary submit-btn" style="margin-top:15px; margin-left:285px;">Add Prescription</button>
                </div>
            </div>
        </div>
    </div>
}