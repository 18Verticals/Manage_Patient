@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["ErrorMessage"]</strong>
    </div>
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Schedule</h4>
    </div>
    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="Add_Schedule" class="btn btn-primary btn-rounded float-right">
            <i class="fa fa-plus"></i> Add Schedule
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("List_Schedule", "Admin")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Schedule..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div style="overflow-x:auto;">
    <table class="table table-striped">
        <thead class="bg-danger text-white">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-border table-striped custom-table datatable mb-0">
                            <thead>
                                <tr>
                                    <th class="text-right">ACTION</th>
                                    <th>Doctor Name</th>
                                    <th>Department Name</th>
                                    <th>Available Date</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scheduleVM in Model)
                                {
                                    <tr>
                                        <td class="text-right">
                                            <a class="dropdown-item" href="@Url.Action("Edit_Schedule", new { scheduleId = scheduleVM.Schedule_ID })">
                                                <i class="fa fa-pencil m-r-5"></i>
                                            </a>

                                            <script type="text/javascript">
                                                function confirmDelete(url) {
                                                    if (confirm("Are you sure you want to delete this Schedule?")) {
                                                        window.location.href = url;
                                                    }
                                                }
                                            </script>
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Schedule", "Admin", new { scheduleId = scheduleVM.Schedule_ID })')">
                                                <i class="fa fa-trash-o m-r-5"></i>
                                            </a>
                                        </td>
                                        <td>@scheduleVM.Dr_FirstName @scheduleVM.Dr_LastName</td>
                                        <td>@scheduleVM.Dept_Name</td>
                                        <td>@scheduleVM.Available_Date.ToString("dd/MM/yyyy")</td>
                                        <td>@scheduleVM.Start_Time</td>
                                        <td>@scheduleVM.End_Time</td>
                                        <td>@scheduleVM.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <nav aria-label="Schedule Pagination">
                <ul class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Schedule", new { page = Model.PageNumber - 1 })">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="#">@i</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("List_Schedule", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("List_Schedule", new { page = Model.PageNumber + 1 })">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                </ul>
            </nav>
            <script src="assets/js/jquery-3.2.1.min.js"></script>
            <script src="assets/js/popper.min.js"></script>
            <script src="assets/js/bootstrap.min.js"></script>
            <script src="assets/js/jquery.slimscroll.js"></script>
            <script src="assets/js/select2.min.js"></script>
            <script src="assets/js/jquery.dataTables.min.js"></script>
            <script src="assets/js/dataTables.bootstrap4.min.js"></script>
            <script src="assets/js/moment.min.js"></script>
            <script src="assets/js/bootstrap-datetimepicker.min.js"></script>
            <script src="assets/js/app.js"></script>
