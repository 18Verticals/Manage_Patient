@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="color: green;">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="color: red;">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-sm-4 col-3">
        <h4 class="page-title">Schedule</h4>
    </div>
    <div class="col-sm-8 col-9 text-right m-b-20">
        <a href="Add_Schedule" class="btn btn btn-primary btn-rounded float-right"><i class="fa fa-plus"></i>Add Schedule</a>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-border table-striped custom-table datatable mb-0">
                <thead>
                    <tr>
                        <th class="text-right">ACTION</th>

                        <th>Doctor Name</th>
                        <th>Department Name</th>                       
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Available Date</th>
                        <th>Status</th>

                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scheduleVM in Model)
                    {

                        <tr>
                            <td class="text-right">
                                <a class="dropdown-item" href="@Url.Action("Edit_Schedule", new { scheduleId = scheduleVM.Schedule_ID })">
                <i class="fa fa-pencil m-r-5"></i>
            </a>

                                <!-- Add JavaScript confirmation for delete -->
                                <script type="text/javascript">
                                    function confirmDelete(url) {
                                        if (confirm("Are you sure you want to delete this Schedule?")) {
                                            window.location.href = url;
                                        }
                                    }
                                </script>

                                <a class="dropdown-item" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Schedule", "Admin", new { scheduleId = scheduleVM.Schedule_ID })')">
                <i class="fa fa-trash-o m-r-5"></i>
            </a>
                            </td>
                            <td>@scheduleVM.Dr_FirstName</td>
                            <td>@scheduleVM.Dept_Name</td>
                            <td>@scheduleVM.Available_Date.ToString("dd/MM/yyyy")</td>
                            <td>@scheduleVM.Start_Time</td>
                            <td>@scheduleVM.End_Time</td>
                            <td>@scheduleVM.Status</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
<div class="sidebar-overlay" data-reff=""></div>
<script src="assets/js/jquery-3.2.1.min.js"></script>
<script src="assets/js/popper.min.js"></script>
<script src="assets/js/bootstrap.min.js"></script>
<script src="assets/js/jquery.slimscroll.js"></script>
<script src="assets/js/select2.min.js"></script>
<script src="assets/js/jquery.dataTables.min.js"></script>
<script src="assets/js/dataTables.bootstrap4.min.js"></script>
<script src="assets/js/moment.min.js"></script>
<script src="assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="assets/js/app.js"></script>


<div class="row">
    <div class="col-sm-12">
        <div class="see-all">
            <a class="see-all-btn" href="javascript:void(0);">More</a>
        </div>
    </div>
</div>
        </div>