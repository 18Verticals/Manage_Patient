@model List<Patient_Management_System.ViewModel.AppointmentVM>
@{
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
    ViewBag.Title = "Doctor Appointments";
    var selectedDate = ViewBag.SelectedDate ?? DateTime.Now.ToString("yyyy-MM-dd"); // Default to today if not set
}

<div class="container">
    <h2>Appointments</h2>

    <div class="date-picker-container">
        <label for="appointmentDate">Select Date:</label>
        <input type="date" id="appointmentDate" value="@selectedDate" />
        <button id="filterBtn">View Appointments</button>
    </div>

    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Patient Name</th>
                        <th>Appointment Date</th>
                        <th>Phone</th>
                        <th>Disease</th>
                        <th>Time</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.P_FirstName</td>
                            <td>@(appointment.Apt_Date.HasValue ? appointment.Apt_Date.Value.ToString("dd-MM-yyyy") : "N/A")</td>
                            <td>@appointment.Phone</td>
                            <td>@appointment.Diseases</td>
                            <td>@(appointment.Apt_Time.HasValue ? appointment.Apt_Time.Value.ToString(@"hh\:mm") : "N/A")</td>
                            <td>@appointment.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="no-appointments">No appointments found for the selected date.</p>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var appointmentDateInput = document.getElementById("appointmentDate");
        var today = new Date().toISOString().split("T")[0];

        if (!appointmentDateInput.value) {
            appointmentDateInput.value = today; // Set default to today if empty
        }

        // Load today's appointments automatically if no date selected
        var urlParams = new URLSearchParams(window.location.search);
        if (!urlParams.has("selectedDate")) {
            window.location.href = '@Url.Action("Appointments", "Doctor")' + '?selectedDate=' + appointmentDateInput.value;
        }

        // Filter appointments based on selected date
        document.getElementById("filterBtn").addEventListener("click", function () {
            var selectedDate = appointmentDateInput.value;
            if (selectedDate) {
                window.location.href = '@Url.Action("Appointments", "Doctor")' + '?selectedDate=' + selectedDate;
            }
        });
    });
</script>

<style>
    .container {
        text-align: center;
        margin: 20px auto;
    }

    .date-picker-container {
        margin-bottom: 15px;
    }

    #appointmentDate {
        padding: 8px;
        font-size: 16px;
        border: 1px solid #000000;
        border-radius: 6px;
    }

    #filterBtn {
        padding: 8px 15px;
        font-size: 16px;
        color: white;
        background-color: #000000;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        #filterBtn:hover {
            background-color: #007BFF;
        }

    .table-container {
        width: 90%;
        margin: 20px auto;
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
    }

        .styled-table th, .styled-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }

        .styled-table th {
            background-color: #b05bd7;
            color: white;
        }

        .styled-table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

    .no-appointments {
        font-size: 18px;
        color: red;
        font-weight: bold;
        margin-top: 20px;
    }
</style>
