

@{
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
    ViewBag.Title = "Doctor Prescription";
}


<div class="container p-4 mb-3 rounded d-flex justify-content-center align-items-center"
     style="background: linear-gradient(to right, #5e87e6, #d5e3c3); color: white; height: 100px;">
    <h1 class="display-6 text-center">Prescription Details</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-3">
        <form method="get" action="@Url.Action("Prescription", "Doctor")">
            <div class="input-group">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search Prescription..." value="@Request.QueryString["searchQuery"]">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Count > 0)
{


<div class="d-flex justify-content-center">
    <div class="table-responsive" style="max-width: 80%; margin: auto;">
        <table class="table table-border table-striped custom-table datatable mb-0 text-center">
            <thead class="bg-danger text-white">
                <tr>
                    <th>Actions</th>
                    <th>Patient Name</th>
                    <th>Date Issued</th>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th>Instructions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prescription in Model)
                {
                    <tr>

                        <td>
                            <a class="btn btn-sm btn-warning" href="@Url.Action("Edit_Prescription", "Doctor", new { PrescId = prescription.Presc_ID })">
                                <i class="fa fa-pencil"></i>
                            </a>

                            <a class="btn btn-sm btn-danger" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Prescription", "Doctor", new { PrescId = prescription.Presc_ID })')">
                                <i class="fa fa-trash-o"></i>
                            </a>
                        </td>
                        <td>@prescription.P_FirstName @prescription.P_MiddleName</td>
                        <td>@prescription.DateIssued.ToShortDateString()</td>
                        <td>@prescription.Medication</td>
                        <td>@prescription.Dosage</td>
                        <td>@prescription.Instructions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

}
else
{
    <p class="text-center">No prescriptions found.</p>
}




<div class="d-flex justify-content-center mt-3">
    <a href="@Url.Action("Add_Prescription", "Doctor")" class="btn btn-primary btn-rounded">
        <i class="fa fa-plus"></i> Add Prescription
    </a>
</div>

<!-- Include jQuery and DataTables (if not already included in layout) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">

<script>
    $(document).ready(function () {
        $('#prescriptionTable').DataTable({
            "pageLength": 5
        });
    });
</script>

<nav aria-label="Prescription Pagination">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Prescription", new { page = Model.PageNumber - 1 })">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.PageCount; i++)
        {
            if (i == Model.PageNumber)
            {
                <li class="page-item active">
                    <a class="page-link" href="#">@i</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Prescription", new { page = i })">@i</a>
                </li>
            }
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Prescription", new { page = Model.PageNumber + 1 })">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#">Next</a>
            </li>
        }
    </ul>
</nav>
