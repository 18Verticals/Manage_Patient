﻿@model Patient_Management_System.ViewModel.PrescriptionVM

@{
    ViewBag.Title = "Add Prescription";
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
}

@using (Html.BeginForm("Add_Prescription", "Doctor", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
         alert("@ViewBag.Message");
        </script>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title text-center">Add Prescription</h4>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">


                <!-- Department Dropdown -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Patient</label>
                        @Html.DropDownList("Patient_ID", (IEnumerable<SelectListItem>)ViewBag.Dept_ID, "-- Select Patient --", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Patient_ID, "", new { @class = "text-danger" })
                    </div>
                </div>


                <!-- Medication -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Medication</label>
                        @Html.TextAreaFor(model => model.Medication, new { @class = "form-control", rows = 1, required = "required" })
                        @Html.ValidationMessageFor(model => model.Medication, "", new { @class = "text-danger" })
                    </div>
                </div>



                <!-- Diseases -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Dosage</label>
                        @Html.TextBoxFor(model => model.Dosage, new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <!-- Instructions -->
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Instructions</label>
                        @Html.TextBoxFor(model => model.Instructions, new { @class = "form-control", required = "required" })
                    </div>
                </div>
                <div class="m-t-20 text-center">
                    <button class="btn btn-primary submit-btn" style="margin-left:130px; ">Add Prescription</button>
                </div>
            </div>
        </div>
    </div>
}





