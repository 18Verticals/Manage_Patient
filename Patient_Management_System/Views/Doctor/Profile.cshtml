@{
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
}

<!-- Web Banner Section -->
<div class="container p-4 mb-3 rounded d-flex justify-content-center align-items-center"
     style="background: linear-gradient(to right, #5e87e6, #d5e3c3); color: white; height: 100px;">
    <h1 class="display-6 text-center">Doctor Profile</h1>
</div>

<div class="container">
    <div class="row">
        @foreach (var doctorVM in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card doctor-card p-4">
                    <div class="doctor-profile text-center">
                        @if (!string.IsNullOrEmpty(doctorVM.Dr_ImagePath))
                        {
                            <img src="@Url.Content(doctorVM.Dr_ImagePath)" alt="Doctor Image" class="img-fluid doctor-img mb-3" />
                        }
                        else
                        {
                            <span class="text-muted">No Image</span>
                        }
                    </div>
                    <h4 class="text-center text-dark">Dr. @doctorVM.Dr_FirstName @doctorVM.Dr_LastName</h4>
                    <p class="text-muted text-center font-italic">@doctorVM.Dept_Name</p>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Email:</strong> @doctorVM.Dr_Email</li>
                        <li class="list-group-item"><strong>Phone:</strong> @doctorVM.Dr_Phone</li>
                        <li class="list-group-item"><strong>Gender:</strong> @doctorVM.Dr_Gender</li>
                        <li class="list-group-item"><strong>DOB:</strong> @doctorVM.Dr_DOB.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item"><strong>Degree:</strong> @doctorVM.Dr_Qualification</li>
                        <li class="list-group-item"><strong>Address:</strong> @doctorVM.Dr_Address, @doctorVM.Dr_City, @doctorVM.Dr_State - @doctorVM.Dr_Pincode</li>
                        <li class="list-group-item"><strong>Fees:</strong> ₹ @doctorVM.Fees</li>
                        <li class="list-group-item">
                            <strong>Status:</strong>
                            <span class="badge @(doctorVM.Dr_Status == "Active" ? "badge-success" : "badge-danger")">
                                @doctorVM.Dr_Status
                            </span>
                        </li>
                    </ul>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Edit_Profile", "Doctor" ,new { doctorId = doctorVM.Doctor_ID })" class="btn btn-warning btn-sm">
                            <i class="fa fa-pencil"></i> Edit
                        </a>
                        
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/assets/js/jquery-3.2.1.min.js"></script>
<script src="~/assets/js/popper.min.js"></script>
<script src="~/assets/js/bootstrap.min.js"></script>
<script src="~/assets/js/jquery.slimscroll.js"></script>
<script src="~/assets/js/select2.min.js"></script>
<script src="~/assets/js/jquery.dataTables.min.js"></script>
<script src="~/assets/js/dataTables.bootstrap4.min.js"></script>
<script src="~/assets/js/moment.min.js"></script>
<script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="~/assets/js/app.js"></script>

<style>
    .doctor-card {
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        background: #fff;
        transition: transform 0.3s ease-in-out;
    }

        .doctor-card:hover {
            transform: translateY(-5px);
        }

    .doctor-profile img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #007bff;
        padding: 5px;
    }

    .list-group-item {
        font-size: 15px;
        padding: 10px 15px;
        background: #f9f9f9;
        border: none;
    }

    .btn-sm {
        padding: 7px 12px;
        font-size: 14px;
        font-weight: bold;
    }

    .badge-success {
        background-color: #28a745;
        padding: 5px 10px;
        font-size: 13px;
        border-radius: 5px;
    }

    .badge-danger {
        background-color: #dc3545;
        padding: 5px 10px;
        font-size: 13px;
        border-radius: 5px;
    }
</style>
