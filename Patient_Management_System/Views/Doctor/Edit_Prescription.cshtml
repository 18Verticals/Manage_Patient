@model Patient_Management_System.ViewModel.PrescriptionVM
@{
    ViewBag.Title = "Edit Prescription";
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
}

@using (Html.BeginForm("Edit_Prescription", "Doctor", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <script>
         alert("@ViewBag.Message");
        </script>
    }

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h4 class="page-title text-center">Update Prescription</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="row">
                @Html.HiddenFor(m => m.Presc_ID)

                <!-- Patient Selection -->
                <!--<div class="col-md-6">
        <div class="form-group">
            <label>Patient</label>
            @Html.DropDownListFor(model => model.Patient_ID, ViewBag.Patient_ID as SelectList, "Select a Patient", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Patient_ID, "", new { @class = "text-danger" })
        </div>
    </div>-->
                <!-- Doctor Selection -->
                <!--<div class="col-md-6">
        <div class="form-group">
            <label>Doctor</label>
            @Html.DropDownListFor(model => model.Doctor_ID, ViewBag.Doctor_ID as SelectList, "Select a Doctor", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
        </div>
    </div>-->

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Patient</label>
                        @Html.DropDownListFor(model => model.Patient_ID, ViewBag.Patient_ID as SelectList, "Select a Patient", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Patient_ID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Doctor</label>
                        @Html.DropDownList("Doctor_ID", ViewBag.Doctor_ID as SelectList, "Select a Doctor", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.Doctor_ID, "", new { @class = "text-danger" })
                    </div>
                </div>


                <!-- Medication -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Medication</label>
                        @Html.EditorFor(model => model.Medication, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Medication, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Instructions -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Instruction</label>
                        @Html.EditorFor(model => model.Instructions, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Instructions, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Dosage -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Dosage</label>
                        @Html.EditorFor(model => model.Dosage, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        @Html.ValidationMessageFor(model => model.Dosage, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Appointment Date -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date</label>
                        @Html.EditorFor(model => model.DateIssued, new { htmlAttributes = new { @class = "form-control", type = "date", min = DateTime.Now.ToString("yyyy-MM-dd"), required = "required" } })
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="text-center mt-4">
                <button class="btn btn-primary submit-btn">Update Prescription</button>
            </div>

        </div>
    </div>
}
