
@{
    ViewBag.Title = "Schedule List";
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
}

<div class="container p-4 mb-3 rounded d-flex justify-content-center align-items-center"
     style="background: linear-gradient(to right, #5e87e6, #d5e3c3); color: white; height: 100px;">
    <h1 class="display-6 text-center">Schedule Details</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <strong style="color: red;">@TempData["ErrorMessage"]</strong>

        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="container d-flex justify-content-center">
    <div class="table-responsive" style="max-width: 80%;">
        <table class="table table-bordered text-center">
            <thead class="table-primary">
                <tr>
                    <th></th>
                    @*<th>Doctor</th>
                    <th>Speciality</th>*@
                    <th>Available Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var scheduleVM in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex justify-content-center">
                                <a class="btn btn-warning btn-sm mx-1" href="@Url.Action("Edit_Schedule", new { scheduleId = scheduleVM.Schedule_ID })">
                                    <i class="fa fa-pencil"></i>
                                </a>

                                <script type="text/javascript">
                                    function confirmDelete(url) {
                                        if (confirm("Are you sure you want to delete this schedule?")) {
                                            window.location.href = url;
                                        }
                                    }
                                </script>

                                <a class="btn btn-danger btn-sm mx-1" href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete_Schedule", new { Schedule_ID = scheduleVM.Schedule_ID })')">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </div>
                        </td>

                        @*<td>@scheduleVM.Dr_FirstName @scheduleVM.Dr_LastName</td>*@
                        @*<td>@scheduleVM.Dept_Name</td>*@
                        <td>@scheduleVM.Available_Date.ToString("dd/MM/yyyy")</td>
                        <td>@scheduleVM.Start_Time</td>
                        <td>@scheduleVM.End_Time</td>
                        <td>@scheduleVM.Status</td>
                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-center mt-3">
    <a href="@Url.Action("Add_Schedule", "Doctor")" class="btn btn-primary btn-rounded">
        <i class="fa fa-plus"></i> Add Schedule
    </a>
</div>
